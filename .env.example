# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Required for any non-localhost deployment: the shared secret you enter on
# the login screen. Leave unset to disable auth for local use.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# First-run partner account (created only when no users exist).
# If ADMIN_PASSWORD is omitted, one is generated and printed to the server log.
#ADMIN_EMAIL=partner@yourfirm.in
#ADMIN_PASSWORD=
#ADMIN_NAME=Managing Partner

# ---------------------------------------------------------------------------
# Compliance Panel (GST)
# ---------------------------------------------------------------------------
# Which tier the intake form defaults to: draft | pro
#DEFAULT_PANEL_TIER=pro

# Pro tier — frontier models, full client facts, zero-data-retention routing
#PRO_MODEL_REVENUE=x-ai/grok-4.3
#PRO_MODEL_ASSESSEE=anthropic/claude-opus-4.8
#PRO_MODEL_PROCEDURAL=openai/gpt-5.5
#PRO_MODEL_RISK=google/gemini-3.1-pro-preview
#PRO_MODEL_CHAIRMAN=anthropic/claude-opus-4.8
#VERIFIER_MODEL=google/gemini-3.1-pro-preview

# Draft tier — cheap PAID endpoints, cents per run. Client identifiers are
# ALWAYS stripped before any request leaves the machine and restored locally
# afterwards; every exported page carries a "not for filing" watermark.
#
# There was a free tier on OpenRouter's `:free` endpoints. Every model ID in it
# went stale and the whole tier failed silently in production, taking notice
# reading down with it — the intake reader borrows the tier's grounding model.
# Free endpoints churn faster than a professional tool can track and cannot
# carry the web plugin the grounding stage needs. Matters saved with
# tier="free" still resolve to this tier, never to pro.
#DRAFT_MODEL_REVENUE=x-ai/grok-4.3
#DRAFT_MODEL_ASSESSEE=google/gemini-3.5-flash
#DRAFT_MODEL_PROCEDURAL=google/gemini-3.6-flash
#DRAFT_MODEL_RISK=x-ai/grok-4.3
#DRAFT_MODEL_CHAIRMAN=google/gemini-3.6-flash
#DRAFT_VERIFIER_MODEL=google/gemini-3.5-flash

# Current-law grounding: one web search per run, shared by all counsel, so the
# panel does not argue amendments, circulars, amnesty windows or limitation
# extensions from a training snapshot.
#PANEL_WEB_GROUNDING=true
#GROUNDING_MODEL=google/gemini-3.1-pro-preview
#DRAFT_GROUNDING_MODEL=google/gemini-3.5-flash
#WEB_MAX_RESULTS=6

# Token routing. Effort is set per seat: limitation arithmetic and the final
# determination get more than a lookup does.
#EFFORT_PROCEDURAL=high
#EFFORT_CHAIRMAN=high
#EFFORT_REVENUE=medium
#EFFORT_ASSESSEE=medium
#EFFORT_RISK=medium
#EFFORT_CROSS_EXAM=medium
#EFFORT_BRIEFING=low
#EFFORT_VERIFIER=low

# Output ceilings, per role. The values below ARE the defaults.
#
# READ THIS BEFORE LOWERING ANY OF THEM. On a reasoning model the ceiling
# bounds the WHOLE completion and the thinking is charged against it first.
# Set it to the length of the answer you want and the model will think until
# it runs out of room, then return nothing at all — a silent empty completion
# that reads like provider flakiness and is not.
#
# These are ceilings, not targets. Billing is per token generated, so headroom
# is close to free; the ceiling exists to stop a runaway, not to shave cost.
# The genuine cost control is the effort setting above.
#
# (This block once shipped values 60-72% BELOW the real defaults under a
# "defaults shown" banner, so uncommenting them cut the chairman's ceiling
# from 16000 to 4500 and reproduced exactly the failure described above.)
#MAX_TOKENS_OPENING=8000
#MAX_TOKENS_CROSS_EXAM=6000
#MAX_TOKENS_CHAIRMAN=16000
#MAX_TOKENS_BRIEFING=4000
#MAX_TOKENS_VERIFIER=5000

# Route Pro-tier calls only to providers that do not retain prompt data
#ENFORCE_ZDR=true

# Firm identity printed on the reply pack
#FIRM_NAME=JCSS & Associates LLP
#FIRM_SUBTITLE=Chartered Accountants

# Include an internal annexure recording panel composition in the export.
# Off by default: the reply pack is a client deliverable. The full record is
# retained in the matter file either way.
#EXPORT_PROVENANCE=false

# Browser origins allowed to call the API. Only needed when the UI is served
# from a different host (e.g. Vercel) to the API. Leave unset for the
# single-service deployment.
#CORS_ORIGINS=https://council.vercel.app
#CORS_ALLOW_VERCEL_PREVIEWS=false

# Session lifetime for signed-in users
#SESSION_TTL_HOURS=72

# Optional overrides (defaults shown)
#COUNCIL_MODELS=openai/gpt-5.5,google/gemini-3.1-pro-preview,anthropic/claude-opus-4.8,x-ai/grok-4.3
#CHAIRMAN_MODEL=google/gemini-3.1-pro-preview
#TITLE_MODEL=google/gemini-2.5-flash
#REASONING_EFFORT=medium        # low | medium | high | none
#REQUEST_TIMEOUT=180            # seconds per model call
#MAX_RETRIES=2
#HISTORY_MAX_TURNS=6            # prior exchanges sent as context
#DATA_DIR=data/conversations       # conversations
#STATE_DIR=data                    # matters and user accounts
#PORT=8001

# ---------------------------------------------------------------------------
# Scanned notices (OCR)
# ---------------------------------------------------------------------------
# Reading image-only PDFs needs the optional engine:
#
#     uv sync --extra ocr
#
# It is local — nothing is sent anywhere. Cloud OCR was rejected because a page
# image cannot be anonymised before upload, which would break the draft tier's
# guarantee. Without the extra, a scanned notice is reported honestly and its
# text must be pasted in by hand.
#
#OCR_DPI=300                    # below 300, figures in annexure tables merge
#OCR_MAX_PAGES=40               # bound on work per document
#OCR_MIN_CONFIDENCE=0.80        # below this a line is flagged as doubtful

# ---------------------------------------------------------------------------
# Cost display
# ---------------------------------------------------------------------------
# Run cost is shown in rupees. A stated constant rather than a live feed: a
# currency API is a network dependency, a failure mode and a privacy question,
# in exchange for precision this number does not need. Set it once a quarter.
#USD_INR_RATE=88.0

# ---------------------------------------------------------------------------
# The generic multi-model council
# ---------------------------------------------------------------------------
# The upstream project this one grew out of. It still works, but no client
# engagement uses it and it doubles the navigation a new user has to
# understand. Off unless set. The deliberation ENGINE is unaffected — the
# compliance panel is built on it either way.
#ENABLE_GENERAL_COUNCIL=false
